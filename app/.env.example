# ---- Banco (dev: SQLite. Produção: troque provider no schema.prisma para postgresql) ----
DATABASE_URL="file:./dev.db"

# Dica: tudo abaixo (exceto SESSION_SECRET e ADMIN_*) também pode ser configurado em Admin → Integrações.

# ---- App ----
APP_URL="http://localhost:3000"
SESSION_SECRET="troque-por-uma-string-longa-e-aleatoria-com-32+-caracteres"
# e-mails (separados por vírgula) e telefones que viram ADMIN no primeiro login
ADMIN_EMAILS="mferreira@conext.click"
ADMIN_PHONES=""

# ---- Login com Google (console.cloud.google.com > Credenciais > OAuth) ----
# redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- ConextBot (API oficial da Meta via ConextBot) ----
CONEXTBOT_BASE_URL="https://app.conext.click/api/v1"
CONEXTBOT_API_KEY="cxk_..."
# nome do template aprovado (categoria AUTHENTICATION) para o código de verificação.
# Se vazio, envia texto simples (só funciona dentro da janela de 24h).
CONEXTBOT_OTP_TEMPLATE=""
CONEXTBOT_OTP_TEMPLATE_LANG="pt_BR"
# segredo que o ConextBot envia no header x-webhook-secret ao chamar /api/webhooks/whatsapp
CONEXTBOT_WEBHOOK_SECRET=""

# ---- Asaas ----
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY=""
# token configurado no webhook do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=""

# ---- E-mail SMTP ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Recanto da Lagoa <contato@seudominio.com.br>"

# ---- IA (Pérola): openai ou anthropic ----
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
